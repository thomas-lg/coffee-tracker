# Copy to .env for `docker compose up`. .env is gitignored, never commit the real one.

# REQUIRED. Signs every access token the app issues; there is no default and the app
# refuses to start without a strong value. Generate one with:
#   openssl rand -base64 48
JWT_KEY=

# Owner of the bind-mounted /config and /photos volumes. Defaults match Unraid's
# nobody:users; override to match whoever owns your host directories.
PUID=99
PGID=100
