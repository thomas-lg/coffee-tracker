# --- .NET ---
bin/
obj/
*.user
appsettings.*.local.json
*.db
*.db-shm
*.db-wal

# --- Angular / Node ---
node_modules/
dist/
.angular/
npm-debug.log*

# --- OCR / uploads (runtime data) ---
photos/
tessdata/*.traineddata

# --- App logs (runtime data) ---
logs/

# --- Tooling caches ---
dotnet/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vs/
.idea/
*.swp


# Secrets — `docker compose up` reads JWT_KEY from a .env file, and that key signs
# every token the app issues. .dockerignore already keeps it out of the build context;
# this keeps it out of the (public) repo.
.env
.env.*
!.env.example

# Per-machine Claude Code state (local paths, permission entries).
.claude/settings.local.json

# APM dependencies. `.claude/skills/` and `.claude/agents/` are vendored copies of
# third-party plugin packs (dotnet/skills, github/awesome-copilot) that apm restores
# from apm.lock.yaml's pinned commits — build output, not source, and redistributing
# them here would ship someone else's code under this repo's LICENSE.
# `.claude/commands/` stays tracked: OpenSpec is part of this repo's own workflow.
apm_modules/
.claude/skills/
.claude/agents/

# Scratch output from local test runs
.tmp-*
