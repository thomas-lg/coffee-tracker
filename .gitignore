# --- .NET ---
bin/
obj/
*.user
appsettings.*.local.json
*.db
*.db-shm
*.db-wal

# --- Angular / Node ---
node_modules/
dist/
.angular/
npm-debug.log*

# --- OCR / uploads (runtime data) ---
photos/
tessdata/*.traineddata

# --- App logs (runtime data) ---
logs/

# --- Tooling caches ---
dotnet/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vs/
.idea/
*.swp


# Secrets — `docker compose up` reads JWT_KEY from a .env file, and that key signs
# every token the app issues. .dockerignore already keeps it out of the build context;
# this keeps it out of the (public) repo.
.env
.env.*
!.env.example

# Per-machine Claude Code state (local paths, permission entries).
.claude/settings.local.json

# APM dependencies
apm_modules/

# Scratch output from local test runs
.tmp-*
